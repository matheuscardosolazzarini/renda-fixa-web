{
  "name": "renda-fixa-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:budget": "node scripts/check-bundle.mjs",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "prepare": "husky",
    "api:snapshot": "node scripts/api-snapshot.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types-check.mjs"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.7.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.4",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
